                          ['OSSL_CAPABILITY_TLS_GROUP_ID',            'id',       'uint',        'duplicate: equal'],
                          ['OSSL_CAPABILITY_TLS_GROUP_ALG',           'alg',      'utf8_string', 'duplicate: equal'],
                          ['OSSL_CAPABILITY_TLS_GROUP_SECURITY_BITS', 'secbits',  'uint',        'duplicate: equal'],
                          ['OSSL_CAPABILITY_TLS_GROUP_IS_KEM',        'is_kem',   'uint',        'duplicate: equal'],
                          ['OSSL_CAPABILITY_TLS_GROUP_MIN_TLS',       'min_tls',  'int',         'duplicate: equal'],
