{-
use OpenSSL::paramnames qw(produce_param_decoder);

sub produce_ssl_param_decoder {
    my $decoder = produce_param_decoder(@_);

    # Remove the unavailable header inclusion.
    $decoder =~ s|#include "prov/proverr.h"||;
    return $decoder;
}
-}

/*
 * There is no need to produce a list of gettables/settables because libssl
 * doesn't support these query functions.
 */
#define tls_group_params_list
#define tls_sigalg_params_list

{- produce_ssl_param_decoder('tls_group_params',
