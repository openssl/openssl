{-
use OpenSSL::paramnames qw(produce_param_decoder);

sub produce_evp_param_decoder {
    my $decoder = produce_param_decoder(@_);

    $decoder =~ s|#include "prov/proverr.h"|#include <openssl/err.h>|;
    $decoder =~ s/ERR_LIB_PROV/ERR_LIB_EVP/g;
    $decoder =~ s/PROV_R_REPEATED_PARAMETER/ERR_R_PASSED_INVALID_ARGUMENT/g;
    return $decoder;
}
-}

#define evp_cipher_len_params_list
{- produce_evp_param_decoder('evp_cipher_len_params',
                         (['OSSL_CIPHER_PARAM_KEYLEN', 'keylen', 'size_t'],
                          ['OSSL_CIPHER_PARAM_IVLEN',  'ivlen',  'size_t'],
                         )); -}
