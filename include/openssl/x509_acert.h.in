#ifndef OPENSSL_X509_ACERT_H
#define OPENSSL_X509_ACERT_H
#pragma once

#include <openssl/x509v3.h>
#include <openssl/x509.h>
#include <openssl/pem.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef struct X509_acert_st X509_ACERT;
typedef struct X509_acert_info_st X509_ACERT_INFO;
typedef struct ossl_object_digest_info_st OSSL_OBJECT_DIGEST_INFO;
typedef struct ossl_issuer_serial_st OSSL_ISSUER_SERIAL;
typedef struct X509_acert_issuer_v2form_st X509_ACERT_ISSUER_V2FORM;

#if !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES)
DECLARE_ASN1_FUNCTIONS_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, X509_ACERT)
DECLARE_ASN1_DUP_FUNCTION_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, X509_ACERT)
DECLARE_ASN1_ITEM_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, X509_ACERT_INFO)
DECLARE_ASN1_ALLOC_FUNCTIONS_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, X509_ACERT_INFO)
DECLARE_ASN1_ALLOC_FUNCTIONS_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, OSSL_OBJECT_DIGEST_INFO)
DECLARE_ASN1_ALLOC_FUNCTIONS_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, OSSL_ISSUER_SERIAL)
DECLARE_ASN1_ALLOC_FUNCTIONS_attr(OSSL_X509PMI_DEPRECATEDIN_4_2, X509_ACERT_ISSUER_V2FORM)
#endif /* !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES) */

