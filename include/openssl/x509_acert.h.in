    ASN1_BIT_STRING *digest);

/** @see OSSL_ISSUER_SERIAL_get0_issuer(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const X509_NAME *OSSL_ISSUER_SERIAL_get0_issuer(const OSSL_ISSUER_SERIAL *isss);
/** @see OSSL_ISSUER_SERIAL_get0_serial(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_INTEGER *OSSL_ISSUER_SERIAL_get0_serial(const OSSL_ISSUER_SERIAL *isss);
/** @see OSSL_ISSUER_SERIAL_get0_issuerUID(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_BIT_STRING *OSSL_ISSUER_SERIAL_get0_issuerUID(const OSSL_ISSUER_SERIAL *isss);

/** @see OSSL_ISSUER_SERIAL_set1_issuer(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int OSSL_ISSUER_SERIAL_set1_issuer(OSSL_ISSUER_SERIAL *isss,
