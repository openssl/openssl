/** @see i2d_X509_ACERT_fp(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int i2d_X509_ACERT_fp(FILE *fp, const X509_ACERT *acert);
#endif /* !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES) */
#endif

#if !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES)
