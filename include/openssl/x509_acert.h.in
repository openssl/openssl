/** @see d2i_X509_ACERT_bio(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 X509_ACERT *d2i_X509_ACERT_bio(BIO *bp, X509_ACERT **acert);
/** @see i2d_X509_ACERT_bio(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int i2d_X509_ACERT_bio(BIO *bp, const X509_ACERT *acert);

/** @see X509_ACERT_sign(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_sign(X509_ACERT *x, EVP_PKEY *pkey, const EVP_MD *md);
/** @see X509_ACERT_sign_ctx(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_sign_ctx(X509_ACERT *x, EVP_MD_CTX *ctx);
/** @see X509_ACERT_verify(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_verify(X509_ACERT *a, EVP_PKEY *r);
#endif /* !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES) */

#define X509_ACERT_VERSION_2 1

#if !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES)
