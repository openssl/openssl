/** @see X509_ACERT_get0_info_sigalg(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const X509_ALGOR *X509_ACERT_get0_info_sigalg(const X509_ACERT *x);
/** @see X509_ACERT_get0_serialNumber(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_INTEGER *X509_ACERT_get0_serialNumber(const X509_ACERT *x);
/** @see X509_ACERT_get0_notBefore(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_TIME *X509_ACERT_get0_notBefore(const X509_ACERT *x);
/** @see X509_ACERT_get0_notAfter(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_TIME *X509_ACERT_get0_notAfter(const X509_ACERT *x);
/** @see X509_ACERT_get0_issuerUID(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const ASN1_BIT_STRING *X509_ACERT_get0_issuerUID(const X509_ACERT *x);

/** @see X509_ACERT_print(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_print(BIO *bp, X509_ACERT *x);
/** @see X509_ACERT_print_ex(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_print_ex(BIO *bp, X509_ACERT *x, unsigned long nmflags,
    unsigned long cflag);

/** @see X509_ACERT_get_attr_count(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_get_attr_count(const X509_ACERT *x);
/** @see X509_ACERT_get_attr_by_NID(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_get_attr_by_NID(const X509_ACERT *x, int nid, int lastpos);
/** @see X509_ACERT_get_attr_by_OBJ(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_get_attr_by_OBJ(const X509_ACERT *x, const ASN1_OBJECT *obj,
    int lastpos);
/** @see X509_ACERT_get_attr(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 X509_ATTRIBUTE *X509_ACERT_get_attr(const X509_ACERT *x, int loc);
/** @see X509_ACERT_delete_attr(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 X509_ATTRIBUTE *X509_ACERT_delete_attr(X509_ACERT *x, int loc);

/** @see X509_ACERT_get_ext_d2i(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 void *X509_ACERT_get_ext_d2i(const X509_ACERT *x, int nid, int *crit, int *idx);
/** @see X509_ACERT_add1_ext_i2d(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add1_ext_i2d(X509_ACERT *x, int nid, void *value, int crit,
    unsigned long flags);
/** @see X509_ACERT_get0_extensions(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 const STACK_OF(X509_EXTENSION) *X509_ACERT_get0_extensions(const X509_ACERT *x);
#endif /* !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES) */

#define OSSL_OBJECT_DIGEST_INFO_PUBLIC_KEY 0
#define OSSL_OBJECT_DIGEST_INFO_PUBLIC_KEY_CERT 1
#define OSSL_OBJECT_DIGEST_INFO_OTHER 2 /* must not be used in RFC 5755 profile */
#if !defined(OPENSSL_NO_DEPRECATED_4_2) || defined(OSSL_LIBX509PMI_NAMES)
/** @see X509_ACERT_set_version(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_set_version(X509_ACERT *x, long version);
/** @see X509_ACERT_set0_holder_entityName(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 void X509_ACERT_set0_holder_entityName(X509_ACERT *x, GENERAL_NAMES *name);
/** @see X509_ACERT_set0_holder_baseCertId(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 void X509_ACERT_set0_holder_baseCertId(X509_ACERT *x, OSSL_ISSUER_SERIAL *isss);
/** @see X509_ACERT_set0_holder_digest(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 void X509_ACERT_set0_holder_digest(X509_ACERT *x,
    OSSL_OBJECT_DIGEST_INFO *dinfo);

/** @see X509_ACERT_add1_attr(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add1_attr(X509_ACERT *x, X509_ATTRIBUTE *attr);
/** @see X509_ACERT_add1_attr_by_OBJ(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add1_attr_by_OBJ(X509_ACERT *x, const ASN1_OBJECT *obj,
    int type, const void *bytes, int len);
/** @see X509_ACERT_add1_attr_by_NID(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add1_attr_by_NID(X509_ACERT *x, int nid, int type,
    const void *bytes, int len);
/** @see X509_ACERT_add1_attr_by_txt(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add1_attr_by_txt(X509_ACERT *x, const char *attrname, int type,
    const unsigned char *bytes, int len);
/** @see X509_ACERT_add_attr_nconf(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_add_attr_nconf(CONF *conf, const char *section,
    X509_ACERT *acert);

/** @see X509_ACERT_set1_issuerName(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_set1_issuerName(X509_ACERT *x, const X509_NAME *name);
/** @see X509_ACERT_set1_serialNumber(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_set1_serialNumber(X509_ACERT *x, const ASN1_INTEGER *serial);
/** @see X509_ACERT_set1_notBefore(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_set1_notBefore(X509_ACERT *x, const ASN1_GENERALIZEDTIME *time);
/** @see X509_ACERT_set1_notAfter(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int X509_ACERT_set1_notAfter(X509_ACERT *x, const ASN1_GENERALIZEDTIME *time);

/** @see OSSL_OBJECT_DIGEST_INFO_get0_digest(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 void OSSL_OBJECT_DIGEST_INFO_get0_digest(const OSSL_OBJECT_DIGEST_INFO *o,
    int *digestedObjectType,
    const X509_ALGOR **digestAlgorithm,
    const ASN1_BIT_STRING **digest);

/** @see OSSL_OBJECT_DIGEST_INFO_set1_digest(3) */
OSSL_X509PMI_DEPRECATEDIN_4_2 int OSSL_OBJECT_DIGEST_INFO_set1_digest(OSSL_OBJECT_DIGEST_INFO *o,
    int digestedObjectType,
