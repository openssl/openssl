*.bin binary
*.der binary
/fuzz/corpora/** binary
*.pfx binary
test/recipes/15-test_ml_dsa_codecs_data/*.dat   binary
test/recipes/15-test_ml_kem_codecs_data/*.dat binary

# The symbol files are unordered sets of lines, so two branches adding
# symbols have no conflict to resolve: take both sides.  A duplicated or
# contradictory entry is caught when the file is read, not by git.
util/*.sym                              merge=union

# For git archive
fuzz/corpora/**                         export-ignore
Configurations/*.norelease.conf         export-ignore
# We generally avoid anything with a name starting with a period.
# However, .ctags.d is precious, so we don't ignore that.
.*                                      export-ignore
.ctags.d                                !export-ignore
util/mktar.sh                           export-ignore
krb5                                    export-ignore
pyca-cryptography                       export-ignore
dev                                     export-ignore
gost-engine                             export-ignore
