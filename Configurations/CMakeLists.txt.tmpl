# CMakeLists.txt for OpenSSL
#
# {- join("\n# ", @autowarntext) -}
#
# Configure writes this file into the build directory when run with
# BUILDFILE=CMakeLists.txt.  CMake must use that same directory as both
# its source and binary directory, so that every path Configure computed
# keeps its meaning:
#
#   cmake -G Ninja .
#   ninja
{-
     use Text::ParseWords;
     use File::Basename;
     use File::Spec::Functions qw(:ALL);
     use OpenSSL::Util;

     # The values of the make variables the Unix Makefile defines and
     # build.info files refer to, as unexpanded strings in make syntax.
     our %mkvars = ();

     our $prefix = $config{prefix} || "/usr/local";
     our $openssldir =
         $config{openssldir}
         ? (file_name_is_absolute($config{openssldir})
            ? $config{openssldir}
            : catdir($prefix, $config{openssldir}))
         : catdir($prefix, "ssl");
     our $libdir = $config{libdir} || "lib$target{multilib}";
     our $bindir = $config{bindir} || "bin$target{multibin}";

     # Windows builds (the VC targets) use the Windows Makefile's commands
     # and install locations; everything else uses the Unix Makefile's.
     our $windows = ($target{build_scheme}->[1] // '') eq 'windows';
     our ($win_prefix, $win_openssldir, $win_libdir, $win_modulesdir);
     if ($windows) {
         my $scheme = $target{build_scheme};
         my $flavour = $scheme->[$#$scheme];
         my $installroot =
             $ENV{$flavour eq "VC-WOW" ? "ProgramFiles(x86)" : "ProgramW6432"}
             // $ENV{ProgramFiles};
         my $commonroot =
             $ENV{$flavour eq "VC-WOW" ? "CommonProgramFiles(x86)"
                                       : "CommonProgramW6432"}
             // $ENV{CommonProgramFiles};

         $win_prefix = canonpath($config{prefix} || "$installroot\\OpenSSL");
         $win_openssldir =
             $config{openssldir}
             ? (file_name_is_absolute($config{openssldir})
                ? canonpath($config{openssldir})
                : catdir($win_prefix, $config{openssldir}))
             : canonpath("$commonroot\\SSL");
         $win_libdir = $config{libdir} || "lib";
         $win_modulesdir =
             catdir(file_name_is_absolute($win_libdir)
                    ? $win_libdir : catdir($win_prefix, $win_libdir),
                    "ossl-modules");
     }

     %mkvars = (
         PLATFORM => $config{target},
         SRCDIR => $config{sourcedir},
         BLDDIR => $config{builddir},
         FIPSKEY => $config{FIPSKEY},
         VERSION => $config{full_version},
         VERSION_NUMBER => $config{version},
         SHLIB_VERSION_NUMBER => $config{shlib_version},
         MAJOR => $config{major},
         MINOR => $config{minor},
         PERL => $config{PERL},
         CROSS_COMPILE => $config{CROSS_COMPILE},
         CC => '$(CROSS_COMPILE)' . $config{CC},
         CXX => $config{CXX} ? '$(CROSS_COMPILE)' . $config{CXX} : '',
         AR => '$(CROSS_COMPILE)' . $config{AR},
         RANLIB => $config{RANLIB} ? '$(CROSS_COMPILE)' . $config{RANLIB} : '',
         INSTALLTOP => $prefix,
         OPENSSLDIR => $openssldir,
         LIBDIR => file_name_is_absolute($libdir) ? "" : $libdir,
         libdir => file_name_is_absolute($libdir)
                   ? $libdir : '$(INSTALLTOP)/$(LIBDIR)',
         MODULESDIR => '$(libdir)/ossl-modules',
         BINDIR => file_name_is_absolute($bindir) ? "" : $bindir,
         bindir => file_name_is_absolute($bindir)
                   ? $bindir : '$(INSTALLTOP)/$(BINDIR)',
         PKGCONFIGDIR => '$(libdir)/pkgconfig',
         MANDIR => '$(INSTALLTOP)/share/man',
         DOCDIR => '$(INSTALLTOP)/share/doc/openssl',
         HTMLDIR => '$(DOCDIR)/html',
         MANSUFFIX => 'ossl',
         RELEASE_DATE => release_date(),
         CMAKECONFIGDIR => '$(libdir)/cmake/OpenSSL',
         APPS_OPENSSL => catfile("apps", "openssl"),
         PERLASM_SCHEME => $target{perlasm_scheme},
         FIPSMODULE => join(' ', map { platform->dso($_) } fipsmodules()),
         FIPSMODULENAME => join(' ', map { basename(platform->dso($_)) }
                                     fipsmodules()),
         PROCESSOR => '',
         S390X_VEC_CFLAGS => $config{s390x_vector_cflags} // '',
         CPPFLAGS => join(' ',
                          (map { "-D".$_ } @{$config{CPPDEFINES}}),
                          (map { "-I".$_ } @{$config{CPPINCLUDES}}),
                          @{$config{CPPFLAGS}}),
         CFLAGS => join(' ', @{$config{CFLAGS}}),
         CXXFLAGS => join(' ', @{$config{CXXFLAGS}}),
         LDFLAGS => join(' ', @{$config{LDFLAGS}}),
         EX_LIBS => join(' ', @{$config{LDLIBS}}),
         CNF_CPPFLAGS => join(' ', $target{cppflags} || (),
                              (map { "-D".$_ } @{$target{defines}},
                                               @{$config{defines}}),
                              (map { "-I".$_ } @{$target{includes}},
                                               @{$config{includes}}),
                              @{$config{cppflags}}),
         CNF_CFLAGS => join(' ', $target{cflags} || (), @{$config{cflags}}),
         CNF_CXXFLAGS => join(' ', $target{cxxflags} || (),
                              @{$config{cxxflags}}),
         CNF_LDFLAGS => join(' ', $target{lflags} || (), @{$config{lflags}}),
         CNF_EX_LIBS => join(' ', $target{ex_libs} || (), @{$config{ex_libs}}),
         LIB_CPPFLAGS => join(' ', $target{lib_cppflags} || (),
                              $target{shared_cppflag} || (),
                              (map { '-D'.$_ }
                                   @{$target{lib_defines} || ()},
                                   @{$target{shared_defines} || ()},
                                   @{$config{lib_defines} || ()},
                                   @{$config{shared_defines} || ()}),
                              (map { '-I'.quotify1($_) }
                                   @{$target{lib_includes}},
                                   @{$target{shared_includes}},
                                   @{$config{lib_includes}},
                                   @{$config{shared_includes}}),
                              @{$config{lib_cppflags}},
                              @{$config{shared_cppflag}},
                              (map { '-D'.$_ }
                                   'OPENSSLDIR="\"$(OPENSSLDIR)\""',
                                   'MODULESDIR="\"$(MODULESDIR)\""'),
                              '$(CNF_CPPFLAGS)', '$(CPPFLAGS)'),
         LIB_CFLAGS => join(' ', $target{lib_cflags} || (),
                            $target{shared_cflag} || (),
                            @{$config{lib_cflags}},
                            @{$config{shared_cflag}},
                            '$(CNF_CFLAGS)', '$(CFLAGS)'),
         LIB_CXXFLAGS => join(' ', $target{lib_cxxflags} || (),
                              $target{shared_cxxflag} || (),
                              @{$config{lib_cxxflags}},
                              @{$config{shared_cxxflag}},
                              '$(CNF_CXXFLAGS)', '$(CXXFLAGS)'),
         LIB_LDFLAGS => join(' ', $target{shared_ldflag} || (),
                             $config{shared_ldflag} || (),
                             '$(CNF_LDFLAGS)', '$(LDFLAGS)'),
         LIB_EX_LIBS => '$(CNF_EX_LIBS) $(EX_LIBS)',
         DSO_CPPFLAGS => join(' ', $target{dso_cppflags} || (),
                              $target{module_cppflags} || (),
                              (map { '-D'.$_ }
                                   @{$target{dso_defines}},
                                   @{$target{module_defines}},
                                   @{$config{dso_defines} || ()},
                                   @{$config{module_defines} || ()}),
                              (map { '-I'.quotify1($_) }
                                   @{$target{dso_includes}},
                                   @{$target{module_includes}},
                                   @{$config{dso_includes}},
                                   @{$config{module_includes}}),
                              @{$config{dso_cppflags}},
                              @{$config{module_cppflags}},
                              '$(CNF_CPPFLAGS)', '$(CPPFLAGS)'),
         DSO_CFLAGS => join(' ', $target{dso_cflags} || (),
                            $target{module_cflags} || (),
                            @{$config{dso_cflags}},
                            @{$config{module_cflags}},
                            '$(CNF_CFLAGS)', '$(CFLAGS)'),
         DSO_CXXFLAGS => join(' ', $target{dso_cxxflags} || (),
                              $target{module_cxxflags} || (),
                              @{$config{dso_cxxflags}},
                              @{$config{module_cxxflag}},
                              '$(CNF_CXXFLAGS)', '$(CXXFLAGS)'),
         DSO_LDFLAGS => join(' ', $target{dso_ldflags} || (),
                             $target{module_ldflags} || (),
                             @{$config{dso_ldflags}},
                             @{$config{module_ldflags}},
                             '$(CNF_LDFLAGS)', '$(LDFLAGS)'),
         DSO_EX_LIBS => '$(CNF_EX_LIBS) $(EX_LIBS)',
         BIN_CPPFLAGS => join(' ', $target{bin_cppflags} || (),
                              (map { '-D'.$_ } @{$config{bin_defines} || ()}),
                              @{$config{bin_cppflags}},
                              '$(CNF_CPPFLAGS)', '$(CPPFLAGS)'),
         BIN_CFLAGS => join(' ', $target{bin_cflags} || (),
                            @{$config{bin_cflags}},
                            '$(CNF_CFLAGS)', '$(CFLAGS)'),
         BIN_CXXFLAGS => join(' ', $target{bin_cxxflags} || (),
                              @{$config{bin_cxxflags}},
                              '$(CNF_CXXFLAGS)', '$(CXXFLAGS)'),
         BIN_LDFLAGS => join(' ', $target{bin_lflags} || (),
                             @{$config{bin_lflags}},
                             '$(CNF_LDFLAGS)', '$(LDFLAGS)'),
         BIN_EX_LIBS => '$(CNF_EX_LIBS) $(EX_LIBS)',
         );

     # The Windows Makefile's variables that differ from the Unix one's.
     if ($windows) {
         my $flags = sub { join(' ', grep { defined && $_ ne '' } @_) };
         my $dq = sub { '"' . shift . '"' };

         %mkvars = (
             %mkvars,
             CC => $config{CC},
             CPP => $config{CPP},
             LD => $config{LD},
             AR => $config{AR},
             AS => $config{AS},
             RC => $config{RC},
             MT => $config{MT},
             ARFLAGS => join(' ', @{$config{ARFLAGS}}),
             ASFLAGS => join(' ', @{$config{ASFLAGS}}),
             RCFLAGS => join(' ', @{$config{RCFLAGS}}),
             MTFLAGS => join(' ', @{$config{MTFLAGS}}),
             COUTFLAG => $target{coutflag},
             LDOUTFLAG => $target{ldoutflag},
             AROUTFLAG => $target{aroutflag},
             ASOUTFLAG => $target{asoutflag},
             RCOUTFLAG => $target{rcoutflag},
             MTINFLAG => $target{mtinflag},
             MTOUTFLAG => $target{mtoutflag},
             PROCESSOR => $config{processor} // '',
             INSTALLTOP => $win_prefix,
             OPENSSLDIR => $win_openssldir,
             MODULESDIR => $win_modulesdir,
             CPPFLAGS => $flags->((map { "-D".$_ } @{$config{CPPDEFINES}}),
                                  (map { "-I".$_ } @{$config{CPPINCLUDES}}),
                                  @{$config{CPPFLAGS}}),
             CNF_ASFLAGS => $flags->($target{asflags}, @{$config{asflags}}),
             CNF_CPPFLAGS => $flags->($target{cppflags},
                                      (map { '-D'.quotify1($_) }
                                           @{$target{defines}},
                                           @{$config{defines}}),
                                      (map { '-I'.$dq->($_) }
                                           @{$target{includes}},
                                           @{$config{includes}}),
                                      @{$config{cppflags}}),
             LIB_ASFLAGS => $flags->($target{lib_asflags},
                                     @{$config{lib_asflags}},
                                     '$(CNF_ASFLAGS)', '$(ASFLAGS)'),
             LIB_CPPFLAGS => $flags->($target{lib_cppflags},
                                      $target{shared_cppflag},
                                      (map { '-D'.quotify1($_) }
                                           @{$target{lib_defines}},
                                           @{$target{shared_defines}},
                                           @{$config{lib_defines}},
                                           @{$config{shared_defines}}),
                                      (map { '-I'.quotify1($_) }
                                           @{$target{lib_includes}},
                                           @{$target{shared_includes}},
                                           @{$config{lib_includes}},
                                           @{$config{shared_includes}}),
                                      @{$config{lib_cppflags}},
                                      @{$config{shared_cppflag}},
                                      (map { '-D'.quotify1($_) }
                                           "OPENSSLDIR=\"$win_openssldir\"",
                                           "MODULESDIR=\"$win_modulesdir\""),
                                      '$(CNF_CPPFLAGS)', '$(CPPFLAGS)'),
             DSO_ASFLAGS => $flags->($target{dso_asflags},
                                     $target{module_asflags},
                                     @{$config{dso_asflags}},
                                     @{$config{module_asflags}},
                                     '$(CNF_ASFLAGS)', '$(ASFLAGS)'),
             DSO_CPPFLAGS => $flags->($target{dso_cppflags},
                                      $target{module_cppflag},
                                      (map { '-D'.quotify1($_) }
                                           @{$target{dso_defines}},
                                           @{$target{module_defines}},
                                           @{$config{dso_defines}},
                                           @{$config{module_defines}}),
                                      (map { '-I'.quotify1($_) }
                                           @{$target{dso_includes}},
                                           @{$target{module_includes}},
                                           @{$config{dso_includes}},
                                           @{$config{module_includes}}),
                                      @{$config{dso_cppflags}},
                                      @{$config{module_cppflags}},
                                      '$(CNF_CPPFLAGS)', '$(CPPFLAGS)'),
             DSO_LDFLAGS => $flags->($target{dso_lflags},
                                     $target{module_ldflags},
                                     @{$config{dso_lflags}},
                                     @{$config{module_ldflags}},
                                     '$(CNF_LDFLAGS)', '$(LDFLAGS)'),
             BIN_ASFLAGS => $flags->($target{bin_asflags},
                                     @{$config{bin_asflags}},
                                     '$(CNF_ASFLAGS)', '$(ASFLAGS)'),
             );
     }

     # CPPFLAGS_Q is used for one thing only: to build up buildinf.h
     {
         my $cppflags1 = $mkvars{CPPFLAGS};
         my $cppflags2 = $mkvars{CNF_CPPFLAGS};
         my $lib_cppflags = join(' ', $target{lib_cppflags} || (),
                                 $target{shared_cppflag} || (),
                                 (map { '-D'.$_ }
                                      @{$target{lib_defines} || ()},
                                      @{$target{shared_defines} || ()},
                                      @{$config{lib_defines} || ()},
                                      @{$config{shared_defines} || ()}),
                                 (map { '-I'.quotify1($_) }
                                      @{$target{lib_includes}},
                                      @{$target{shared_includes}},
                                      @{$config{lib_includes}},
                                      @{$config{shared_includes}}),
                                 @{$config{lib_cppflags}},
                                 @{$config{shared_cppflag}});
         s|([\\"])|\\$1|g foreach ($cppflags1, $cppflags2, $lib_cppflags);
         $mkvars{CPPFLAGS_Q} = join(' ', $lib_cppflags || (),
                                    $cppflags2 || (), $cppflags1 || ());
     }

     # The FIPS module, of which there is at most one.
     sub fipsmodules {
         my @m = grep { !$unified_info{attributes}->{modules}->{$_}->{noinst}
                        && $unified_info{attributes}->{modules}->{$_}->{fips} }
                 @{$unified_info{modules}};
         die "More that one FIPS module" if scalar @m > 1;
         return @m;
     }

     sub release_date {
         use Time::Piece;
         my $t = localtime;

         if ($config{release_date}) {
             eval { $t = Time::Piece->strptime($config{release_date},
                                              "%d %b %Y"); }
                 || die "Parsing \$config{release_date}"
                        . " ('$config{release_date}') failed: $@";
         }
         return $t->strftime("%Y-%m-%d");
     }

     # Expands make variable references, $(NAME), until none are left.
     sub mkexpand {
         my $s = shift;
         my $n = 0;

         while ($s =~ s/\$\(([A-Za-z_][A-Za-z0-9_]*)\)/$mkvars{$1} \/\/ ''/ge) {
             die "Recursive make variable in \"$s\"\n" if ++$n > 50;
         }
         return $s;
     }

     # Splits a command line into words the way a Windows program's C
     # runtime does: double quotes group, and backslashes are literal
     # except before a double quote.
     sub winwords {
         my $s = shift;
         my @words = ();
         my $w;

         while (length $s) {
             if ($s =~ s/^\s+//) {
                 push @words, $w if defined $w;
                 undef $w;
                 next;
             }
             my $quoted = 0;
             $w //= '';
             while (length $s && ($quoted || $s !~ /^\s/)) {
                 if ($s =~ s/^(\\*)"//) {
                     my $n = length $1;
                     $w .= '\\' x int($n / 2);
                     if ($n % 2) {
                         $w .= '"';
                     } else {
                         $quoted = !$quoted;
                     }
                 } elsif ($s =~ s/^(\\+)//) {
                     $w .= $1;
                 } else {
                     $s =~ s/^(.)//s;
                     $w .= $1;
                 }
             }
         }
         push @words, $w if defined $w;
         return @words;
     }

     # Expands a string in make syntax and splits it into words the way the
     # shell running a make recipe would.
     sub mkwords {
         my $s = mkexpand(join(' ', @_));

         return grep { $_ ne '' } ($windows ? winwords($s) : shellwords($s));
     }

     # The text of a CMake "SHELL:" option for the make syntax flags in @_.
     # CMake splits it by Unix shell rules on every platform, so on Windows
     # the words are quoted for that.
     sub shellopt {
         return "SHELL:" . mkexpand(join(' ', @_)) unless $windows;
         return "SHELL:" . join(' ', map { my $x = $_;
                                           $x =~ s/([\\"\$`])/\\$1/g;
                                           "\"$x\"" } mkwords(@_));
     }

     # One quoted CMake argument.
     sub cmesc {
         my $s = shift;

         $s =~ s/([\\"\$;])/\\$1/g;
         return $s;
     }
     sub cmq { '"' . cmesc(shift) . '"' }
     sub cmql { join(' ', map { cmq($_) } @_) }

     # One quoted CMake argument naming a file.  CMake gets every file as
     # an absolute path: it can confuse a relative name with another
     # file of the same base name.
     sub cmpath {
         my $p = shift;

         $p =~ s|\\|/|g if $windows;
         return cmq($p) if file_name_is_absolute($p);
         return '"${CMAKE_BINARY_DIR}/' . cmesc($p) . '"';
     }
     sub cmpathl { join(' ', map { cmpath($_) } @_) }

     # A CMake target name for a file or product name.
     sub cmtarget {
         my $s = shift;

         $s =~ s/[^A-Za-z0-9_.+-]/_/g;
         return $s;
     }

     sub is_library { my $x = shift; grep { $x eq $_ } @{$unified_info{libraries}} }
     sub is_program { my $x = shift; grep { $x eq $_ } @{$unified_info{programs}} }
     sub is_module { my $x = shift; grep { $x eq $_ } @{$unified_info{modules}} }

     # Dependencies of a custom command, quoted: products become their
     # CMake targets, anything else is a file.
     sub cmdeps {
         return map {
             (is_library($_) || is_program($_) || is_module($_))
                 ? cmq(cmtarget($_)) : cmpath($_)
         } @_;
     }

     # The flags each intent compiles with, as in the Unix Makefile.
     our %intent_cflags = (
         shlib => '$(LIB_CFLAGS) $(LIB_CPPFLAGS)',
         lib => '$(LIB_CFLAGS) $(LIB_CPPFLAGS)',
         dso => '$(DSO_CFLAGS) $(DSO_CPPFLAGS)',
         bin => '$(BIN_CFLAGS) $(BIN_CPPFLAGS)',
         );
     our %intent_cxxflags = (
         shlib => '$(LIB_CXXFLAGS) $(LIB_CPPFLAGS)',
         lib => '$(LIB_CXXFLAGS) $(LIB_CPPFLAGS)',
         dso => '$(DSO_CXXFLAGS) $(DSO_CPPFLAGS)',
         bin => '$(BIN_CXXFLAGS) $(BIN_CPPFLAGS)',
         );

     "";
-}

cmake_minimum_required(VERSION 3.21)

if(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_BINARY_DIR)
  message(FATAL_ERROR
    "Run CMake in the directory Configure wrote this file to: cmake -G Ninja .")
endif()

# A change to Configure or its inputs reruns Configure with the same
# arguments; a change to configdata.pm or the templates regenerates this
# file.  Either way the new file is then read in place of this one.
set(OPENSSL_RECONFIGURE_INPUTS
  {- cmpathl(catfile($config{sourcedir}, "Configure"),
             catfile($config{sourcedir}, "config"),
             @{$config{build_infos}}, @{$config{conf_files}}) -})
set(OPENSSL_REGENERATE_INPUTS
  {- cmpathl("configdata.pm", @{$config{build_file_templates}}) -})
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  ${OPENSSL_RECONFIGURE_INPUTS} ${OPENSSL_REGENERATE_INPUTS})
if(NOT OPENSSL_REGENERATED)
  set(OPENSSL_REGENERATE "")
  foreach(f IN LISTS OPENSSL_RECONFIGURE_INPUTS)
    if("${f}" IS_NEWER_THAN "${CMAKE_BINARY_DIR}/configdata.pm")
      set(OPENSSL_REGENERATE "-r")
    endif()
  endforeach()
  if(NOT OPENSSL_REGENERATE)
    foreach(f IN LISTS OPENSSL_REGENERATE_INPUTS)
      if("${f}" IS_NEWER_THAN "${CMAKE_CURRENT_LIST_FILE}")
        set(OPENSSL_REGENERATE "-")
      endif()
    endforeach()
  endif()
  if(OPENSSL_REGENERATE)
    if(OPENSSL_REGENERATE STREQUAL "-r")
      set(OPENSSL_REGENERATE_ARGS "-r")
    else()
      set(OPENSSL_REGENERATE_ARGS "")
    endif()
    execute_process(
      COMMAND {- cmql(mkwords('$(PERL)')) -} configdata.pm ${OPENSSL_REGENERATE_ARGS}
      WORKING_DIRECTORY "${CMAKE_BINARY_DIR}"
      RESULT_VARIABLE OPENSSL_REGENERATE_RESULT)
    if(OPENSSL_REGENERATE_RESULT)
      message(FATAL_ERROR "perl configdata.pm ${OPENSSL_REGENERATE_ARGS} failed")
    endif()
    set(OPENSSL_REGENERATED TRUE)
    include("${CMAKE_CURRENT_LIST_FILE}")
    return()
  endif()
endif()

