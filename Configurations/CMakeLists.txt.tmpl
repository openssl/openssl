{-
     # Installation, in four components: "sw" (libraries, headers,
     # modules, programs, pkg-config and CMake files), "ssldirs" (the
     # OPENSSLDIR tree), "fips" (the FIPS module and fipsmodule.cnf) and
     # "docs".  Every destination is absolute and DESTDIR is honoured.
     # The Windows build does not install yet.
     return "" if $windows;
     my $abs = sub { rel2abs(shift, rel2abs($config{builddir})) };
     my $dest = sub { cmq(mkexpand(shift)) };
     my %attrs = %{$unified_info{attributes}};
     my $out = "\nset(CMAKE_INSTALL_PREFIX " . $dest->('$(INSTALLTOP)') . ")\n";
     my $code = sub { "install(CODE [==[\n" . shift . "]==] COMPONENT "
                      . shift . ")\n" };
     my $dir644 = "PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ";
     my $dir755 = "PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE"
         . " GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE";
     my $link = sub {
         my ($target, $link) = @_;
         "  message(STATUS \"Linking: \$ENV{DESTDIR}$link -> $target\")\n"
             . "  file(CREATE_LINK " . cmq($target)
             . " \"\$ENV{DESTDIR}" . cmesc($link) . "\" SYMBOLIC)\n";
     };

     # Headers: the generated ones from the build tree, every other one
     # from the source tree.
     my @genhdrs = sort grep { m|^include/openssl/[^/]+\.h$| }
                   keys %{$unified_info{generate}};
     my %genhdr = map { basename($_) => 1 } @genhdrs;
     my @srchdrs = grep { !$genhdr{basename($_)} }
                   sort glob(catfile($config{sourcedir},
                                     "include", "openssl", "*.h"));
     push @srchdrs, catfile($config{sourcedir}, "ms", "applink.c")
         unless $disabled{uplink};
     $out .= "install(FILES " . cmpathl(@srchdrs, @genhdrs)
         . "\n  DESTINATION " . $dest->('$(INSTALLTOP)/include/openssl')
         . " $dir644 COMPONENT sw)\n";

     # Libraries
     my @libs = grep { !$attrs{libraries}->{$_}->{noinst} }
                @{$unified_info{libraries}};
     my @static = map { platform->staticlib($_) // () } @libs;
     $out .= "install(FILES " . cmpathl(@static)
         . "\n  DESTINATION " . $dest->('$(libdir)')
         . " $dir644 COMPONENT sw)\n" if @static;
     unless ($disabled{shared}) {
         foreach (@libs) {
             my $full = platform->sharedlib($_) // next;
             my $simple = platform->sharedlib_simple($_);

             $out .= "install(FILES " . cmpath($full)
                 . " DESTINATION " . $dest->('$(libdir)')
                 . " $dir755 COMPONENT sw)\n";
             $out .= $code->($link->(basename($full),
                                     mkexpand('$(libdir)') . "/"
                                     . basename($simple)), "sw")
                 if defined $simple && $simple ne $full;
         }
     }

     # pkg-config and CMake files
     foreach my $exp (['pkg-config', '$(PKGCONFIGDIR)'],
                      ['cmake', '$(CMAKECONFIGDIR)']) {
         my @files = grep { ($attrs{generate}->{$_}->{exporter} // '')
                                eq $exp->[0] }
                     sort keys %{$unified_info{generate}};
         $out .= "install(FILES " . cmpathl(@files)
             . "\n  DESTINATION " . $dest->($exp->[1])
             . " $dir644 COMPONENT sw)\n" if @files;
     }

     # Modules and programs
     my @modules = map { platform->dso($_) }
                   grep { !$attrs{modules}->{$_}->{noinst}
                          && !$attrs{modules}->{$_}->{fips} }
                   @{$unified_info{modules}};
     $out .= "install(FILES " . cmpathl(@modules)
         . "\n  DESTINATION " . $dest->('$(MODULESDIR)')
         . " $dir755 COMPONENT sw)\n" if @modules;
     my @programs = map { platform->bin($_) }
                    grep { !$attrs{programs}->{$_}->{noinst} }
                    @{$unified_info{programs}};
     $out .= "install(PROGRAMS " . cmpathl(@programs)
         . "\n  DESTINATION " . $dest->('$(bindir)') . " COMPONENT sw)\n"
         if @programs;

     # Scripts: ordinary ones in bindir, "misc" ones in OPENSSLDIR/misc,
     # each with its link name, if any, as a symbolic link to it.
     foreach my $script (grep { !$attrs{scripts}->{$_}->{noinst} }
                         @{$unified_info{scripts}}) {
         my $misc = $attrs{scripts}->{$script}->{misc};
         my $dir = mkexpand($misc ? '$(OPENSSLDIR)/misc' : '$(bindir)');
         my $linkname = $attrs{scripts}->{$script}->{linkname};

         $out .= "install(PROGRAMS " . cmpath($script)
             . " DESTINATION " . cmq($dir) . " COMPONENT "
             . ($misc ? "ssldirs" : "sw") . ")\n";
         $out .= $code->($link->(basename($script),
                                 "$dir/" . basename($linkname)),
                         $misc ? "ssldirs" : "sw")
             if $linkname;
     }

     # The OPENSSLDIR tree.  openssl.cnf and ct_log_list.cnf are always
     # installed as *.dist, and as themselves only when not already there.
     {
         my $d = mkexpand('$(OPENSSLDIR)');
         my $c = "  set(d \"\$ENV{DESTDIR}" . cmesc($d) . "\")\n"
             . "  file(MAKE_DIRECTORY \"\${d}/certs\" \"\${d}/private\""
             . " \"\${d}/misc\")\n";

         foreach my $cnf ("openssl.cnf", "ct_log_list.cnf") {
             my $src = cmq($abs->(catfile($config{sourcedir}, "apps", $cnf)));

             $c .= "  message(STATUS \"Installing: \${d}/$cnf.dist\")\n"
                 . "  file(COPY_FILE $src \"\${d}/$cnf.dist\""
                 . " ONLY_IF_DIFFERENT)\n"
                 . "  file(CHMOD \"\${d}/$cnf.dist\" $dir644)\n"
                 . "  if(NOT EXISTS \"\${d}/$cnf\")\n"
                 . "    message(STATUS \"Installing: \${d}/$cnf\")\n"
                 . "    file(COPY_FILE $src \"\${d}/$cnf\")\n"
                 . "    file(CHMOD \"\${d}/$cnf\" $dir644)\n"
                 . "  endif()\n";
         }
         $out .= $code->($c, "ssldirs");
     }

     # The FIPS module and its configuration
     unless ($disabled{fips}) {
         $out .= "install(FILES " . cmpathl(mkwords('$(FIPSMODULE)'))
             . "\n  DESTINATION " . $dest->('$(MODULESDIR)')
             . " $dir755 COMPONENT fips)\n"
             . "install(FILES " . cmpath("providers/fipsmodule.cnf")
             . "\n  DESTINATION " . $dest->('$(OPENSSLDIR)')
             . " $dir644 COMPONENT fips)\n";
     }

     # Documentation
     unless ($disabled{docs}) {
         my $c = "";

         foreach my $sec (@docsections) {
             my @pages = @{$unified_info{mandocs}->{$sec} // []};
             my $dir = mkexpand('$(MANDIR)') . "/$sec";

             next unless @pages;
             $c .= "  file(MAKE_DIRECTORY \"\$ENV{DESTDIR}" . cmesc($dir) . "\")\n"
                 . "  execute_process(COMMAND "
                 . cmql(mkwords('$(PERL)'),
                        $abs->(catfile($config{sourcedir}, "util",
                                       "install-man-pages.pl")),
                        'install',
                        $abs->(catdir($config{sourcedir}, "doc", $sec)),
                        $abs->(catdir("doc", $sec)))
                 . "\n      \"\$ENV{DESTDIR}" . cmesc($dir) . "\" "
                 . cmql(mkexpand('$(MANSUFFIX)'), @pages)
                 . "\n    WORKING_DIRECTORY " . cmq($abs->("."))
                 . "\n    RESULT_VARIABLE r)\n"
                 . "  if(r)\n"
                 . "    message(FATAL_ERROR \"Installing the $sec manual"
                 . " pages failed\")\n"
                 . "  endif()\n";
         }
         $out .= $code->($c, "docs") if $c;
         foreach my $sec (@docsections) {
             my @pages = @{$unified_info{htmldocs}->{$sec} // []};

             $out .= "install(FILES " . cmpathl(@pages)
                 . "\n  DESTINATION " . $dest->("\$(HTMLDIR)/$sec")
                 . " $dir644 COMPONENT docs)\n" if @pages;
         }
         my @images = map { catfile($config{sourcedir}, $_) }
                      @{$unified_info{imagedocs}->{man7} // []};
         $out .= "install(FILES " . cmpathl(@images)
             . "\n  DESTINATION " . $dest->('$(HTMLDIR)/man7/img')
             . " $dir644 COMPONENT docs)\n" if @images;
     }

     $out;
-}
{-
     sub generatetarget {
         my %args = @_;
         my $name = cmtarget($args{target});

         # build.info hooks these into the default build.
         return "\nadd_custom_target(" . cmq($name) . " ALL"
             . (@{$args{deps}}
                ? "\n  DEPENDS " . join(' ', cmdeps(@{$args{deps}})) : "")
             . ")\n";
     }

     sub generatesrc {
         my %args = @_;
         my $src = $args{src};
         my @gen = @{$args{generator}};
         my $gen0 = $gen[0];
         my @gen_args = @gen[1 .. $#gen];
         my @gen_incs = map { "-I$_" } @{$args{generator_incs}};
         my @incs = map { "-I$_" } @{$args{incs}};
         my @defs = map { "-D$_" } @{$args{defs}};
         my @deps = cmdeps(@{$args{generator_deps}}, @{$args{deps}});
         my @tofile = (mkwords('$(PERL)'),
                       catfile($config{sourcedir}, "util",
                               "file-from-stdout.pl"),
                       $src);
         our %gen_targets;
         unless (%gen_targets) {
             foreach my $t (keys %{$unified_info{generate}}) {
                 $gen_targets{join(" ", @{$unified_info{generate}->{$t}})}++;
             }
         }
         my $writes_own_files = $gen_targets{join(" ", @gen)} > 1;
         my @command;
         my @extra_deps = ();

         if ($src =~ /\.html$/ || $src =~ /\.(\d)$/) {
             # Documentation is not built yet.
             return "";
         } elsif (platform->isdef($src)) {
             my $target = platform->def($src);
             (my $mkdef_os = $target{shared_target}) =~ s|-shared$||;
             my $ord_name = $gen[1] || $args{product};

             if ($windows) {
                 $mkdef_os = 'windows';
                 $ord_name = $gen[1]
                     || basename(platform->dsoname($args{product}));
             }

             $src = $target;
             @tofile[$#tofile] = $target;
             @command = (@tofile, mkwords('$(PERL)'),
                         catfile($config{sourcedir}, "util", "mkdef.pl"),
                         ($args{intent} eq 'lib'
                          ? ('--version', mkexpand('$(VERSION_NUMBER)')) : ()),
                         '--type', $args{intent}, '--ordinals', $gen0,
                         '--name', $ord_name, '--OS', $mkdef_os);
             push @extra_deps,
                 cmpath(catfile($config{sourcedir}, "util", "mkdef.pl"));
         } elsif (platform->isasm($src) || platform->iscppasm($src)) {
             my @cppflags = mkwords($intent_cflags{$args{intent}});

             # On Windows, perlasm output is NASM source with its own name.
             if ($windows && platform->isasm($src)) {
                 $src = platform->asm($src);
                 @tofile[$#tofile] = $src;
             }
             if ($gen0 =~ /\.pl$/) {
                 @command = ('${CMAKE_COMMAND}', '-E', 'env',
                             $windows
                             ? 'ASM=' . mkexpand('$(AS)')
                             : 'CC=' . mkexpand('$(CC)'),
                             mkwords('$(PERL)'), @gen_incs, $gen0,
                             mkwords(@gen_args),
                             mkexpand('$(PERLASM_SCHEME)'),
                             @incs, @cppflags, @defs,
                             mkwords('$(PROCESSOR)'), $src);
             } elsif ($gen0 =~ /\.m4$/) {
                 @command = (@tofile, 'm4', '-B', '8192', @gen_incs, $gen0,
                             mkwords(@gen_args));
             } elsif ($gen0 =~ /\.S$/ && $windows) {
                 @command = (@tofile, mkwords('$(CPP)'), '/D__ASSEMBLER__',
                             @incs, @cppflags, @defs, $gen0);
             } elsif ($gen0 =~ /\.S$/) {
                 return "\n# $src: preprocessed .S generators are not"
                     . " supported yet\n";
             } else {
                 die "Generator type for $src unknown: $gen0\n";
             }
         } elsif ($gen0 =~ m|^.*\.in$|) {
             my $dofile = abs2rel(rel2abs(catfile($config{sourcedir},
                                                  "util", "dofile.pl")),
                                  rel2abs($config{builddir}));
             my @perlmodules = ();
             my %perlmoduleincs = ();
             my %perlmoduledeps = ();

             foreach my $x (('configdata.pm', @{$args{deps}})) {
                 my ($i, $m, $d);

                 if ($x =~ /\|/) {
                     $i = $`;
                     $d = $';
                     $m = $d;
                     $m =~ s|\.pm$||;
                     $m =~ s|/|::|g;
                     $d = catfile($i, $d) if $i;
                 } elsif ($x =~ /\.pm$/) {
                     $i = dirname($x);
                     $m = basename($x, '.pm');
                     $d = $x;
                 } else {
                     $d = $x;
                 }
                 push @perlmodules, '-M'.$m if $m;
                 $perlmoduledeps{$d} = 1;
                 $perlmoduleincs{'-I'.$i} = 1 if $i;
             }
             @deps = cmdeps(@{$args{generator_deps}}, sort keys %perlmoduledeps);
             @command = (@tofile, mkwords('$(PERL)'),
                         (sort keys %perlmoduleincs), @perlmodules,
                         $dofile, "-o$config{build_file}", $gen0,
                         mkwords(@gen_args));
         } elsif (is_program($gen0)) {
             my $bin = platform->bin($gen0);
             my @run = (mkwords('$(PERL)'),
                        catfile($config{builddir}, "util", "wrap.pl"),
                        $bin, mkwords(@gen_args));

             return "\n# $src: generated with $bin, not supported yet\n"
                 if $writes_own_files;
             @command = (@tofile, @run);
             push @extra_deps, cmq(cmtarget($gen0));
         } else {
             return "\n# $src: generator writing several files is not"
                 . " supported yet\n"
                 if $writes_own_files;
             @command = (@tofile, mkwords('$(PERL)'), @gen_incs, $gen0,
                         mkwords(@gen_args));
         }

         return "\nadd_custom_command(OUTPUT " . cmpath($src)
             . "\n  COMMAND " . join(' ', map { $_ eq '${CMAKE_COMMAND}'
                                                ? $_ : cmq($_) } @command)
             . "\n  DEPENDS " . join(' ', cmpath($gen0), @deps, @extra_deps)
             . "\n  VERBATIM)\n";
     }

     # Each object file of the Makefile build is an object library of its
     # own, compiled with exactly the flags the Makefile uses for it.  On
     # Windows, assembler and resource files are built by custom commands
     # into object files that are used directly.
     sub objtarget { "obj_" . cmtarget(shift) }

     # The sources of object $obj, with generated assembler names in their
     # platform form.
     sub objsources {
         my $obj = shift;

         return map {
             my $x = $_;
             ($windows && platform->isasm($x) && grep { $x eq $_ } @generated)
                 ? platform->asm($x) : $x
         } @{$unified_info{sources}->{$obj} // []};
     }

     # Is object $obj built by a custom command rather than by CMake?
     sub custom_obj {
         my $obj = shift;

         return 0 unless $windows;
         my $asmext = platform->asmext();
         return grep { /\.rc$/ || /\Q$asmext\E$/ || /\.S$/ } objsources($obj);
     }

     # The file a custom built object is written to.
     sub custom_obj_file {
         my $obj = shift;

         return grep(/\.rc$/, objsources($obj))
             ? platform->res($obj) : platform->obj($obj);
     }

     # The CMake text naming the objects in @_ as sources of a product.
     sub objrefs {
         return join('', map {
             "\n  " . (custom_obj($_)
                       ? cmpath(custom_obj_file($_))
                       : "\$<TARGET_OBJECTS:" . objtarget($_) . ">")
         } @_);
     }

     sub src2obj {
         my %args = @_;
         my @srcs = $windows ? objsources($args{obj}) : @{$args{srcs}};
         my @incs = map { "-I$_" } @{$args{incs}};
         my @defs = map { "-D$_" } @{$args{defs}};

         if ($windows) {
             my $intent = { shlib => 'LIB', lib => 'LIB', dso => 'DSO',
                            bin => 'BIN' }->{$args{intent}};
             my @cflags = mkwords("\$(${intent}_CFLAGS)",
                                  (map { "-I\"$_\"" } @{$args{incs}}),
                                  "\$(${intent}_CPPFLAGS)", @defs);
             my @asflags = mkwords("\$(${intent}_ASFLAGS)");

             if (custom_obj($args{obj})) {
                 my $out = custom_obj_file($args{obj});
                 my @cmds;

                 if ($srcs[0] =~ /\.rc$/) {
                     @cmds = ([ mkwords('$(RC) $(RCFLAGS)'),
                                mkexpand('$(RCOUTFLAG)') . $out, @srcs ]);
                 } elsif ($srcs[0] =~ /\.S$/) {
                     @cmds = ([ mkwords('$(PERL)'),
                                catfile($config{sourcedir}, "util",
                                        "file-from-stdout.pl"),
                                "$out.asm", mkwords('$(CC)'), '/EP',
                                '-D__ASSEMBLER__', @cflags, @srcs ],
                              [ mkwords('$(AS)'), @asflags,
                                mkwords('$(ASOUTFLAG)') , $out, "$out.asm" ]);
                 } else {
                     @cmds = ([ mkwords('$(AS)'), @asflags,
                                mkwords('$(ASOUTFLAG)'), $out, @srcs ]);
                 }
                 return "\nadd_custom_command(OUTPUT " . cmpath($out)
                     . join('', map { "\n  COMMAND " . cmql(@$_) } @cmds)
                     . "\n  DEPENDS " . cmpathl(@srcs, @{$args{deps}})
                     . "\n  VERBATIM)"
                     . "\nset_source_files_properties(" . cmpath($out)
                     . " PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)\n";
             }

             my $obj = objtarget($args{obj});
             return "\nadd_library($obj OBJECT "
                 . cmpathl(@srcs, @{$args{deps}}) . ")"
                 . "\ntarget_compile_options($obj PRIVATE "
                 . cmq(shellopt("\$(${intent}_CFLAGS)",
                                (map { "-I\"$_\"" } @{$args{incs}}),
                                "\$(${intent}_CPPFLAGS)", @defs)) . ")"
                 . "\nadd_dependencies($obj generated_mandatory)\n";
         }

         # Windows resource files are only built on Windows.
         return "" if grep /\.rc$/, @srcs;

         my $obj = objtarget($args{obj});
         my $extra = "";
         $extra = ' -march=z13 -mvx $(S390X_VEC_CFLAGS)'
             if grep m{(?:^|/)(ml_kem_vec128|ml_dsa_ntt_vec128)\.c$}, @srcs;
         my $flags;

         if (grep /\.s$/, @srcs) {
             $flags = $intent_cflags{$args{intent}};
         } elsif (grep /\.(cc|cpp)$/, @srcs) {
             $flags = join(' ', @incs, @defs,
                           $intent_cxxflags{$args{intent}});
         } else {
             $flags = join(' ', @incs, @defs,
                           $intent_cflags{$args{intent}}) . $extra;
         }

         return "\nadd_library($obj OBJECT "
             . cmpathl(@srcs, @{$args{deps}}) . ")"
             . "\ntarget_compile_options($obj PRIVATE "
             . cmq(shellopt($flags)) . ")"
             . "\nadd_dependencies($obj generated_mandatory)\n";
     }

     sub obj2lib {
         my %args = @_;
         my $lib = $args{lib};
         my $name = cmtarget($lib);
         my $file = platform->staticlib($lib);
         my $base = basename($file, platform->libext());
         my $dir = dirname($file);
         my $prefix = "";

         if ($base =~ /^lib/) {
             $prefix = "lib";
             $base = $';
         }
         return "\nadd_library($name STATIC" . objrefs(@{$args{objs}}) . ")"
             . "\nset_target_properties($name PROPERTIES"
             . " PREFIX " . cmq($prefix)
             . " OUTPUT_NAME " . cmq($base)
             . " SUFFIX " . cmq(platform->libext())
             . " ARCHIVE_OUTPUT_DIRECTORY " . outdir($file) . ")"
             . "\nadd_dependencies(build_libs $name)\n";
     }

     # The quoted CMake output directory of $file.
     sub outdir {
         my $dir = dirname(shift);

         $dir =~ s|\\|/|g if $windows;
         return "\"\${CMAKE_BINARY_DIR}" . ($dir eq '.' ? '' : "/$dir") . "\"";
     }

     # What linking against the libraries in @_ takes, as the Makefile
     # does it.  On Unix, static libraries are linked by file (here, by
     # CMake target) and others with -L and -l; on Windows, static
     # libraries by file and shared libraries by their import library.
     # Returns the -L flags, the link items and the CMake targets the link
     # must wait for.
     sub link_inputs {
         my @linkdirs = ();
         my @linklibs = ();
         my @linkdeps = ();

         foreach (@_) {
             next unless defined $_;
             if (platform->isstaticlib($_)) {
                 # "libfoo.a" names the static form of library "libfoo".
                 (my $lib = $_) =~ s/\.a$//;
                 $lib = $_ unless is_library($lib);
                 push @linklibs, cmtarget($lib);
             } elsif ($windows) {
                 if ($disabled{shared}) {
                     push @linklibs, cmtarget($_);
                 } else {
                     push @linklibs, platform->sharedlib_import($_);
                     push @linkdeps, cmtarget($_) . "_shared";
                 }
             } else {
                 my $d = "-L" . dirname($_);
                 my $l = basename($_);
                 $l =~ s/^lib//;
                 push @linklibs, "-l$l";
                 push @linkdirs, $d unless grep { $d eq $_ } @linkdirs;
                 if ($disabled{shared}) {
                     push @linkdeps, cmtarget($_);
                 } else {
                     push @linkdeps, cmtarget($_) . "_shared";
                     push @linkdeps, cmtarget($_) . "_simple"
                         if defined platform->sharedlib_simple($_);
                 }
             }
         }
         return (\@linkdirs, \@linklibs, \@linkdeps);
     }

     # The CMake text for a linked product: properties naming its file
     # exactly, its link flags (in make syntax) and libraries, and what it
     # waits for.
     sub link_props {
         my %args = @_;
         my $name = $args{name};
         my $file = $args{file};
         my $outdir = outdir($file);
         my $out = "\nset_target_properties($name PROPERTIES"
             . " PREFIX \"\" SUFFIX \"\" OUTPUT_NAME " . cmq(basename($file))
             . " LIBRARY_OUTPUT_DIRECTORY $outdir"
             . " RUNTIME_OUTPUT_DIRECTORY $outdir"
             . " LINKER_LANGUAGE " . ($args{language} // 'C')
             . ($args{def} ? " LINK_DEPENDS " . cmpath($args{def}) : "")
             . ($args{import}
                ? " IMPORT_PREFIX \"\" IMPORT_SUFFIX \"\""
                  . " ARCHIVE_OUTPUT_NAME " . cmq(basename($args{import}))
                  . " ARCHIVE_OUTPUT_DIRECTORY " . outdir($args{import})
                : "")
             . ")"
             . "\ntarget_link_options($name PRIVATE "
             . cmq(shellopt($args{ldflags})) . ")"
             . "\ntarget_link_libraries($name PRIVATE "
             . cmql(@{$args{libs}}) . ")\n";

         $out .= "add_dependencies(tests $name)\n"
             . "add_dependencies($args{group} $name)\n";
         if ($args{def}) {
             $out .= "add_custom_target(${name}_def DEPENDS "
                 . cmpath($args{def}) . ")"
                 . "\nadd_dependencies($name ${name}_def)\n";
         }
         $out .= "add_dependencies($name " . join(' ', @{$args{deps}}) . ")\n"
             if @{$args{deps}};
         if ($windows) {
             # As in the Windows Makefile, a manifest the linker wrote is
             # embedded with mt.
             my $f = $file;
             my $mt = join(' ', mkwords('$(MT) $(MTFLAGS)'));

             $f =~ s|/|\\|g;
             $out .= "add_custom_command(TARGET $name POST_BUILD"
                 . "\n  COMMAND cmd /C "
                 . cmq("IF EXIST $f.manifest $mt "
                       . mkexpand('$(MTINFLAG)') . "$f.manifest "
                       . mkexpand('$(MTOUTFLAG)') . $f)
                 . "\n  VERBATIM)\n";
         }
         return $out;
     }

     # A module is a CMake MODULE library, linked like a shared library.
     sub obj2dso {
         my %args = @_;
         my $module = $args{module};
         my $name = cmtarget($module);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my @objs = grep { !platform->isdef($_) } @{$args{objs}};
         my @defs = map { platform->def($_) }
                    grep { platform->isdef($_) } @{$args{objs}};
         my %props = (group => 'build_modules',
                      name => $name,
                      file => platform->dso($module),
                      def => $defs[0],
                      deps => $linkdeps);

         if ($windows) {
             $props{ldflags} = join(' ', '$(LDFLAGS) $(DSO_LDFLAGS)',
                                    map { $target{lddefflag} . $_ } @defs);
             $props{libs} = [ @$linklibs, mkwords('$(DSO_EX_LIBS)') ];
         } else {
             my $shared_def = join('', map { ' ' . $target{shared_defflag} . $_ }
                                       @defs);
             $shared_def .= ' ' . $target{shared_fipsflag}
                 if defined $target{shared_fipsflag}
                    && $shared_def =~ m/providers\/fips/;
             $props{ldflags} = '$(DSO_CFLAGS) '
                 . join('', map { "$_ " } @$linkdirs)
                 . '$(DSO_LDFLAGS)' . $shared_def;
             $props{libs} = [ @$linklibs, mkwords('$(DSO_EX_LIBS)') ];
         }
         return "\nadd_library($name MODULE" . objrefs(@objs) . ")"
             . link_props(%props);
     }

     sub obj2bin {
         my %args = @_;
         my $bin = $args{bin};
         my $name = cmtarget($bin);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my $utlibs = $unified_info{unit_test_libs}->{$bin} // '';
         my $cxx = grep /_cc\.o$/, @{$args{objs}};
         my %props = (group => 'build_programs',
                      name => $name,
                      file => platform->bin($bin),
                      language => $cxx ? 'CXX' : 'C',
                      deps => $linkdeps);

         if ($windows) {
             $props{ldflags} = '$(LDFLAGS) $(BIN_LDFLAGS)';
             $props{libs} = [ mkwords($utlibs), @$linklibs,
                              mkwords('$(BIN_EX_LIBS)') ];
         } else {
             my $wrapflags = '';
             $wrapflags = ' ' . join(' ', map { "-Wl,--wrap=$_" }
                                          @{$unified_info{wraps}->{$bin}})
                 if defined $unified_info{wraps}->{$bin};
             $props{ldflags} = ($cxx ? '$(BIN_CXXFLAGS) ' : '$(BIN_CFLAGS) ')
                 . join('', map { "$_ " } @$linkdirs)
                 . '$(BIN_LDFLAGS)' . $wrapflags;
             $props{libs} = [ @$linklibs, mkwords('$(BIN_EX_LIBS)'),
                              mkwords($utlibs) ];
         }
         return "\nadd_executable($name" . objrefs(@{$args{objs}}) . ")"
             . link_props(%props);
     }

     sub in2script {
         my %args = @_;
         my $script = $args{script};
         my @sources = @{$args{sources}};
         my $dofile = abs2rel(rel2abs(catfile($config{sourcedir},
                                              "util", "dofile.pl")),
                              rel2abs($config{builddir}));

         return "\nadd_custom_command(OUTPUT " . cmpath($script)
             . "\n  COMMAND " . cmql(mkwords('$(PERL)'),
                                     catfile($config{sourcedir}, "util",
                                             "file-from-stdout.pl"),
                                     '-x', $script, mkwords('$(PERL)'),
                                     '-I' . $config{builddir},
                                     '-Mconfigdata', $dofile,
                                     "-o$config{build_file}", @sources)
             . "\n  DEPENDS " . cmpathl(@sources, 'configdata.pm')
             . "\n  VERBATIM)"
             . "\nadd_custom_target(" . cmtarget($script) . " ALL DEPENDS "
             . cmpath($script) . ")"
             . "\nadd_dependencies(tests " . cmtarget($script) . ")"
             . "\nadd_dependencies(build_programs " . cmtarget($script) . ")\n";
     }

     # A shared library is a CMake SHARED library whose file is named
     # exactly as the Makefile names it, linked with the Makefile's
     # command line.  Libraries it depends on are linked the same way, and
     # CMake is told about them only for ordering and relinking.
     sub obj2shlib {
         my %args = @_;
         my $lib = $args{lib};
         my $name = cmtarget($lib) . "_shared";
         my $full = platform->sharedlib($lib);
         my $simple = $windows ? undef : platform->sharedlib_simple($lib);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my @objs = grep { !platform->isdef($_) } @{$args{objs}};
         my @defs = map { platform->def($_) }
                    grep { platform->isdef($_) } @{$args{objs}};
         die "More than one exported symbol map" if scalar @defs > 1;
         my %props = (group => 'build_libs',
                      name => $name,
                      file => $full,
                      def => $defs[0],
                      deps => $linkdeps);

         if ($windows) {
             my $import = platform->sharedlib_import($lib);

             $props{import} = $import;
             $props{ldflags} = join(' ', '$(LDFLAGS) $(LIB_LDFLAGS)',
                                    (map { $target{lddefflag} . $_ } @defs),
                                    $target{ld_implib_flag} . $import);
             $props{libs} = [ @$linklibs, mkwords('$(LIB_EX_LIBS)') ];
         } else {
             my $shared_soname = defined $target{shared_sonameflag}
                 ? ' ' . $target{shared_sonameflag} . basename($full) : '';
             my $shared_def = join('', map { ' ' . $target{shared_defflag} . $_ }
                                       @defs);
             $props{ldflags} = '$(LIB_CFLAGS) '
                 . join('', map { "$_ " } @$linkdirs)
                 . '$(LIB_LDFLAGS)' . $shared_soname . $shared_def;
             $props{libs} = [ @$linklibs, mkwords('$(LIB_EX_LIBS)') ];
         }

         my $out = "\nadd_library($name SHARED" . objrefs(@objs) . ")"
             . link_props(%props);

         if ($windows) {
             # Programs in apps, test and fuzz find the DLL beside them.
             $out .= "add_custom_command(TARGET $name POST_BUILD"
                 . join('', map {
                     "\n  COMMAND \${CMAKE_COMMAND} -E copy_if_different "
                         . cmq($full) . " " . cmq("$_/")
                 } qw(apps test fuzz))
                 . "\n  VERBATIM)\n";
         }
         if (defined $simple && $simple ne $full) {
             $out .= "add_custom_command(OUTPUT " . cmpath($simple)
                 . "\n  COMMAND \${CMAKE_COMMAND} -E create_symlink "
                 . cmq(basename($full)) . " " . cmq($simple)
                 . "\n  DEPENDS $name VERBATIM)"
                 . "\nadd_custom_target(" . cmtarget($lib) . "_simple ALL"
                 . " DEPENDS " . cmpath($simple) . ")\n";
         }
         return $out;
     }

     "";
-}
