# The files every compilation may need, generated before anything is
# compiled.
add_custom_target(generated_mandatory ALL
  DEPENDS {- join(' ', cmdeps(@{$unified_info{depends}->{""} // []})) -})
{-
     # Documentation: the whole manual is formatted in one run, and the
     # HTML pages are converted in another, as in the Makefile.
     our @docsections = qw(man1 man3 man5 man7);
     my $out = "";

     unless ($disabled{docs}) {
         my @manpods = map { $unified_info{generate}->{$_}->[0] }
                       map { @{$unified_info{mandocs}->{$_} // []} }
                       @docsections;
         my @htmlpods = map { $unified_info{generate}->{$_}->[0] }
                        map { @{$unified_info{htmldocs}->{$_} // []} }
                        @docsections;

         die "Only roff manual pages are supported with CMake\n"
             unless $config{manpage_format} eq "roff";
         $out .= "\nadd_custom_command(OUTPUT "
             . cmpath("doc/man/.mandocs.stamp")
             . "\n  COMMAND "
             . cmql(mkwords('$(PERL)'),
                    catfile($config{sourcedir}, "util", "mkpod2man.pl"),
                    '-o', 'doc/man', '-m', mkexpand('$(MANSUFFIX)'),
                    '-d', mkexpand('$(RELEASE_DATE)'),
                    '-r', mkexpand('$(VERSION)'), @manpods)
             . "\n  COMMAND \${CMAKE_COMMAND} -E touch doc/man/.mandocs.stamp"
             . "\n  DEPENDS "
             . cmpathl(catfile($config{sourcedir}, "util", "mkpod2man.pl"),
                       @manpods)
             . "\n  VERBATIM)"
             . "\nadd_custom_target(build_man_docs ALL DEPENDS "
             . cmpath("doc/man/.mandocs.stamp") . ")\n";
         $out .= "\nadd_custom_command(OUTPUT "
             . cmpath("doc/html/.htmldocs.stamp")
             . "\n  COMMAND "
             . cmql(mkwords('$(PERL)'),
                    catfile($config{sourcedir}, "util", "mkpod2html.pl"),
                    '-o', 'doc/html', '-r',
                    catdir($config{sourcedir}, "doc"), @htmlpods)
             . "\n  COMMAND \${CMAKE_COMMAND} -E touch doc/html/.htmldocs.stamp"
             . "\n  DEPENDS "
             . cmpathl(catfile($config{sourcedir}, "util", "mkpod2html.pl"),
                       @htmlpods)
             . "\n  VERBATIM)"
             . "\nadd_custom_target(build_html_docs ALL DEPENDS "
             . cmpath("doc/html/.htmldocs.stamp") . ")"
             . "\nadd_custom_target(build_docs)"
             . "\nadd_dependencies(build_docs build_man_docs build_html_docs)\n";
     }
     $out;
-}
{-
     # Installation, in three components: "sw" (libraries, headers,
     # modules, programs, pkg-config and CMake files), "ssldirs" (the
     # OPENSSLDIR tree) and "docs".  Every destination is absolute and
     # DESTDIR is honoured.
     my $abs = sub { rel2abs(shift, rel2abs($config{builddir})) };
     my $dest = sub { cmq(mkexpand(shift)) };
     my %attrs = %{$unified_info{attributes}};
     my $out = "\nset(CMAKE_INSTALL_PREFIX " . $dest->('$(INSTALLTOP)') . ")\n";
     my $code = sub { "install(CODE [==[\n" . shift . "]==] COMPONENT "
                      . shift . ")\n" };
     my $dir644 = "PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ";
     my $dir755 = "PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE"
         . " GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE";
     my $link = sub {
         my ($target, $link) = @_;
         "  message(STATUS \"Linking: \$ENV{DESTDIR}$link -> $target\")\n"
             . "  file(CREATE_LINK " . cmq($target)
             . " \"\$ENV{DESTDIR}" . cmesc($link) . "\" SYMBOLIC)\n";
     };

     # Headers: the generated ones from the build tree, every other one
     # from the source tree.
     my @genhdrs = sort grep { m|^include/openssl/[^/]+\.h$| }
                   keys %{$unified_info{generate}};
     my %genhdr = map { basename($_) => 1 } @genhdrs;
     my @srchdrs = grep { !$genhdr{basename($_)} }
                   sort glob(catfile($config{sourcedir},
                                     "include", "openssl", "*.h"));
     push @srchdrs, catfile($config{sourcedir}, "ms", "applink.c")
         unless $disabled{uplink};
     $out .= "install(FILES " . cmpathl(@srchdrs, @genhdrs)
         . "\n  DESTINATION " . $dest->('$(INSTALLTOP)/include/openssl')
         . " $dir644 COMPONENT sw)\n";

     # Libraries
     my @libs = grep { !$attrs{libraries}->{$_}->{noinst} }
                @{$unified_info{libraries}};
     my @static = map { platform->staticlib($_) // () } @libs;
     $out .= "install(FILES " . cmpathl(@static)
         . "\n  DESTINATION " . $dest->('$(libdir)')
         . " $dir644 COMPONENT sw)\n" if @static;
     unless ($disabled{shared}) {
         foreach (@libs) {
             my $full = platform->sharedlib($_) // next;
             my $simple = platform->sharedlib_simple($_);

             $out .= "install(FILES " . cmpath($full)
                 . " DESTINATION " . $dest->('$(libdir)')
                 . " $dir755 COMPONENT sw)\n";
             $out .= $code->($link->(basename($full),
                                     mkexpand('$(libdir)') . "/"
                                     . basename($simple)), "sw")
                 if defined $simple && $simple ne $full;
         }
     }

     # pkg-config and CMake files
     foreach my $exp (['pkg-config', '$(PKGCONFIGDIR)'],
                      ['cmake', '$(CMAKECONFIGDIR)']) {
         my @files = grep { ($attrs{generate}->{$_}->{exporter} // '')
                                eq $exp->[0] }
                     sort keys %{$unified_info{generate}};
         $out .= "install(FILES " . cmpathl(@files)
             . "\n  DESTINATION " . $dest->($exp->[1])
             . " $dir644 COMPONENT sw)\n" if @files;
     }

     # Modules and programs
     my @modules = map { platform->dso($_) }
                   grep { !$attrs{modules}->{$_}->{noinst}
                          && !$attrs{modules}->{$_}->{fips} }
                   @{$unified_info{modules}};
     $out .= "install(FILES " . cmpathl(@modules)
         . "\n  DESTINATION " . $dest->('$(MODULESDIR)')
         . " $dir755 COMPONENT sw)\n" if @modules;
     my @programs = map { platform->bin($_) }
                    grep { !$attrs{programs}->{$_}->{noinst} }
                    @{$unified_info{programs}};
     $out .= "install(PROGRAMS " . cmpathl(@programs)
         . "\n  DESTINATION " . $dest->('$(bindir)') . " COMPONENT sw)\n"
         if @programs;

     # Scripts: ordinary ones in bindir, "misc" ones in OPENSSLDIR/misc,
     # each with its link name, if any, as a symbolic link to it.
     foreach my $script (grep { !$attrs{scripts}->{$_}->{noinst} }
                         @{$unified_info{scripts}}) {
         my $misc = $attrs{scripts}->{$script}->{misc};
         my $dir = mkexpand($misc ? '$(OPENSSLDIR)/misc' : '$(bindir)');
         my $linkname = $attrs{scripts}->{$script}->{linkname};

         $out .= "install(PROGRAMS " . cmpath($script)
             . " DESTINATION " . cmq($dir) . " COMPONENT "
             . ($misc ? "ssldirs" : "sw") . ")\n";
         $out .= $code->($link->(basename($script),
                                 "$dir/" . basename($linkname)),
                         $misc ? "ssldirs" : "sw")
             if $linkname;
     }

     # The OPENSSLDIR tree.  openssl.cnf and ct_log_list.cnf are always
     # installed as *.dist, and as themselves only when not already there.
     {
         my $d = mkexpand('$(OPENSSLDIR)');
         my $c = "  set(d \"\$ENV{DESTDIR}" . cmesc($d) . "\")\n"
