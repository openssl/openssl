             $c .= "  file(MAKE_DIRECTORY \"\$ENV{DESTDIR}" . cmesc($dir) . "\")\n"
                 . "  execute_process(COMMAND "
                 . cmql(mkwords('$(PERL)'),
                        $abs->(catfile($config{sourcedir}, "util",
                                       "install-man-pages.pl")),
                        'install',
                        $abs->(catdir($config{sourcedir}, "doc", $sec)),
                        $abs->(catdir("doc", $sec)))
                 . "\n      \"\$ENV{DESTDIR}" . cmesc($dir) . "\" "
                 . cmql(mkexpand('$(MANSUFFIX)'), @pages)
                 . "\n    WORKING_DIRECTORY " . cmq($abs->("."))
                 . "\n    RESULT_VARIABLE r)\n"
                 . "  if(r)\n"
                 . "    message(FATAL_ERROR \"Installing the $sec manual"
                 . " pages failed\")\n"
                 . "  endif()\n";
         }
         $out .= $code->($c, "docs") if $c;
         foreach my $sec (@docsections) {
             my @pages = @{$unified_info{htmldocs}->{$sec} // []};

             $out .= "install(FILES " . cmpathl(@pages)
                 . "\n  DESTINATION " . $dest->("\$(HTMLDIR)/$sec")
                 . " $dir644 COMPONENT docs)\n" if @pages;
         }
         my @images = map { catfile($config{sourcedir}, $_) }
                      @{$unified_info{imagedocs}->{man7} // []};
         $out .= "install(FILES " . cmpathl(@images)
             . "\n  DESTINATION " . $dest->('$(HTMLDIR)/man7/img')
             . " $dir644 COMPONENT docs)\n" if @images;
     }
     $out;
