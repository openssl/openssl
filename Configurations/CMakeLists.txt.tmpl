     sub generatesrc {
         my %args = @_;
         my $src = $args{src};
         my @gen = @{$args{generator}};
         my $gen0 = $gen[0];
         my @gen_args = @gen[1 .. $#gen];
         my @gen_incs = map { "-I$_" } @{$args{generator_incs}};
         my @incs = map { "-I$_" } @{$args{incs}};
         my @defs = map { "-D$_" } @{$args{defs}};
         my @deps = cmdeps(@{$args{generator_deps}}, @{$args{deps}});
         my @tofile = (mkwords('$(PERL)'),
                       catfile($config{sourcedir}, "util",
                               "file-from-stdout.pl"),
                       $src);
         our %gen_targets;
         unless (%gen_targets) {
             foreach my $t (keys %{$unified_info{generate}}) {
                 $gen_targets{join(" ", @{$unified_info{generate}->{$t}})}++;
             }
         }
         my $writes_own_files = $gen_targets{join(" ", @gen)} > 1;
         my @command;
         my @extra_deps = ();

         if ($src =~ /\.html$/ || $src =~ /\.(\d)$/) {
             # Documentation is not built yet.
             return "";
         } elsif (platform->isdef($src)) {
             my $target = platform->def($src);
             (my $mkdef_os = $target{shared_target}) =~ s|-shared$||;
             my $ord_name = $gen[1] || $args{product};

             $src = $target;
             @tofile[$#tofile] = $target;
             @command = (@tofile, mkwords('$(PERL)'),
                         catfile($config{sourcedir}, "util", "mkdef.pl"),
                         ($args{intent} eq 'lib'
                          ? ('--version', mkexpand('$(VERSION_NUMBER)')) : ()),
                         '--type', $args{intent}, '--ordinals', $gen0,
                         '--name', $ord_name, '--OS', $mkdef_os);
             push @extra_deps,
                 cmpath(catfile($config{sourcedir}, "util", "mkdef.pl"));
         } elsif (platform->isasm($src) || platform->iscppasm($src)) {
             my @cppflags = mkwords($intent_cflags{$args{intent}});

             if ($gen0 =~ /\.pl$/) {
                 @command = ('${CMAKE_COMMAND}', '-E', 'env',
                             'CC=' . mkexpand('$(CC)'),
                             mkwords('$(PERL)'), @gen_incs, $gen0,
                             mkwords(@gen_args),
                             mkexpand('$(PERLASM_SCHEME)'),
                             @incs, @cppflags, @defs,
                             mkwords('$(PROCESSOR)'), $src);
             } elsif ($gen0 =~ /\.m4$/) {
                 @command = (@tofile, 'm4', '-B', '8192', @gen_incs, $gen0,
