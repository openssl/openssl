                     $i = $`;
                     $d = $';
                     $m = $d;
                     $m =~ s|\.pm$||;
                     $m =~ s|/|::|g;
                     $d = catfile($i, $d) if $i;
                 } elsif ($x =~ /\.pm$/) {
                     $i = dirname($x);
                     $m = basename($x, '.pm');
                     $d = $x;
                 } else {
                     $d = $x;
                 }
                 push @perlmodules, '-M'.$m if $m;
                 $perlmoduledeps{$d} = 1;
                 $perlmoduleincs{'-I'.$i} = 1 if $i;
             }
