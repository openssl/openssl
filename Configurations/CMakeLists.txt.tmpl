         return "\nadd_custom_command(OUTPUT " . cmpath($src)
             . "\n  COMMAND " . join(' ', map { $_ eq '${CMAKE_COMMAND}'
                                                ? $_ : cmq($_) } @command)
             . "\n  DEPENDS " . join(' ', cmpath($gen0), @deps, @extra_deps)
             . "\n  VERBATIM)\n";
     }

     # Each object file of the Makefile build is an object library of its
     # own, compiled with exactly the flags the Makefile uses for it.
     sub objtarget { "obj_" . cmtarget(shift) }

     sub src2obj {
         my %args = @_;
         my @srcs = @{$args{srcs}};

         # Windows resource files are not built yet.
         return "" if grep /\.rc$/, @srcs;

         my $obj = objtarget($args{obj});
         my @incs = map { "-I$_" } @{$args{incs}};
         my @defs = map { "-D$_" } @{$args{defs}};
         my $extra = "";
         $extra = ' -march=z13 -mvx $(S390X_VEC_CFLAGS)'
             if grep m{(?:^|/)(ml_kem_vec128|ml_dsa_ntt_vec128)\.c$}, @srcs;
         my $flags;

         if (grep /\.s$/, @srcs) {
             $flags = mkexpand($intent_cflags{$args{intent}});
         } elsif (grep /\.(cc|cpp)$/, @srcs) {
             $flags = mkexpand(join(' ', @incs, @defs,
                                    $intent_cxxflags{$args{intent}}));
         } else {
             $flags = mkexpand(join(' ', @incs, @defs,
                                    $intent_cflags{$args{intent}}) . $extra);
         }

         return "\nadd_library($obj OBJECT "
             . cmpathl(@srcs, @{$args{deps}}) . ")"
             . "\ntarget_compile_options($obj PRIVATE "
             . cmq("SHELL:$flags") . ")"
             . "\nadd_dependencies($obj generated_mandatory)\n";
     }

     sub obj2lib {
         my %args = @_;
         my $lib = $args{lib};
         my $name = cmtarget($lib);
         my $file = platform->staticlib($lib);
         my $base = basename($file, platform->libext());
         my $dir = dirname($file);
         my $prefix = "";

         if ($base =~ /^lib/) {
             $prefix = "lib";
             $base = $';
         }
         return "\nadd_library($name STATIC"
             . join('', map { "\n  \$<TARGET_OBJECTS:" . objtarget($_) . ">" }
                        @{$args{objs}})
             . ")"
             . "\nset_target_properties($name PROPERTIES"
             . " PREFIX " . cmq($prefix)
             . " OUTPUT_NAME " . cmq($base)
             . " ARCHIVE_OUTPUT_DIRECTORY \"\${CMAKE_BINARY_DIR}"
             . ($dir eq '.' ? '' : "/$dir") . "\")\n";
     }

     # What linking against the libraries in @_ takes, as the Makefile
     # does it: static libraries by file (here, by CMake target), others
     # with -L and -l.  Returns the -L flags, the link items and the
     # CMake targets the link must wait for.
     sub link_inputs {
         my @linkdirs = ();
         my @linklibs = ();
         my @linkdeps = ();

         foreach (@_) {
             next unless defined $_;
             if (platform->isstaticlib($_)) {
                 # "libfoo.a" names the static form of library "libfoo".
                 (my $lib = $_) =~ s/\.a$//;
                 $lib = $_ unless is_library($lib);
                 push @linklibs, cmtarget($lib);
             } else {
                 my $d = "-L" . dirname($_);
                 my $l = basename($_);
                 $l =~ s/^lib//;
                 push @linklibs, "-l$l";
                 push @linkdirs, $d unless grep { $d eq $_ } @linkdirs;
                 if ($disabled{shared}) {
                     push @linkdeps, cmtarget($_);
                 } else {
                     push @linkdeps, cmtarget($_) . "_shared";
                     push @linkdeps, cmtarget($_) . "_simple"
                         if defined platform->sharedlib_simple($_);
                 }
             }
         }
         return (\@linkdirs, \@linklibs, \@linkdeps);
     }

     # The CMake text for a linked product: properties naming its file
     # exactly, its link flags and libraries, and what it waits for.
     sub link_props {
         my %args = @_;
         my $name = $args{name};
         my $file = $args{file};
         my $dir = dirname($file);
         my $outdir = "\"\${CMAKE_BINARY_DIR}"
             . ($dir eq '.' ? '' : "/$dir") . "\"";
         my $out = "\nset_target_properties($name PROPERTIES"
             . " PREFIX \"\" SUFFIX \"\" OUTPUT_NAME " . cmq(basename($file))
             . " LIBRARY_OUTPUT_DIRECTORY $outdir"
             . " RUNTIME_OUTPUT_DIRECTORY $outdir"
             . " LINKER_LANGUAGE " . ($args{language} // 'C')
             . ($args{def} ? " LINK_DEPENDS " . cmpath($args{def}) : "")
             . ")"
             . "\ntarget_link_options($name PRIVATE "
             . cmq("SHELL:" . $args{ldflags}) . ")"
             . "\ntarget_link_libraries($name PRIVATE "
             . cmql(@{$args{libs}}) . ")\n";

         $out .= "add_dependencies(tests $name)\n";
         if ($args{def}) {
             $out .= "add_custom_target(${name}_def DEPENDS "
                 . cmpath($args{def}) . ")"
                 . "\nadd_dependencies($name ${name}_def)\n";
         }
         $out .= "add_dependencies($name " . join(' ', @{$args{deps}}) . ")\n"
             if @{$args{deps}};
         return $out;
     }

     # A module is a CMake MODULE library, linked like a shared library.
     sub obj2dso {
         my %args = @_;
         my $module = $args{module};
         my $name = cmtarget($module);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my @objs = grep { !platform->isdef($_) } @{$args{objs}};
         my @defs = map { platform->def($_) }
                    grep { platform->isdef($_) } @{$args{objs}};
         my $shared_def = join('', map { ' ' . $target{shared_defflag} . $_ }
                                   @defs);
         $shared_def .= ' ' . $target{shared_fipsflag}
             if defined $target{shared_fipsflag}
                && $shared_def =~ m/providers\/fips/;

         return "\nadd_library($name MODULE"
             . join('', map { "\n  \$<TARGET_OBJECTS:" . objtarget($_) . ">" }
                        @objs)
             . ")"
             . link_props(name => $name,
                          file => platform->dso($module),
                          def => $defs[0],
                          ldflags => mkexpand('$(DSO_CFLAGS) '
                                              . join('', map { "$_ " }
                                                         @$linkdirs)
                                              . '$(DSO_LDFLAGS)'
                                              . $shared_def),
                          libs => [ @$linklibs, mkwords('$(DSO_EX_LIBS)') ],
                          deps => $linkdeps);
     }

     sub obj2bin {
         my %args = @_;
         my $bin = $args{bin};
         my $name = cmtarget($bin);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my $wrapflags = '';
         $wrapflags = ' ' . join(' ', map { "-Wl,--wrap=$_" }
                                      @{$unified_info{wraps}->{$bin}})
             if defined $unified_info{wraps}->{$bin};
         my $utlibs = $unified_info{unit_test_libs}->{$bin} // '';
         my $cxx = grep /_cc\.o$/, @{$args{objs}};
         my $cmdflags = $cxx ? '$(BIN_CXXFLAGS)' : '$(BIN_CFLAGS)';

         return "\nadd_executable($name"
             . join('', map { "\n  \$<TARGET_OBJECTS:" . objtarget($_) . ">" }
                        @{$args{objs}})
             . ")"
             . link_props(name => $name,
                          file => platform->bin($bin),
                          language => $cxx ? 'CXX' : 'C',
                          ldflags => mkexpand("$cmdflags "
                                              . join('', map { "$_ " }
                                                         @$linkdirs)
                                              . '$(BIN_LDFLAGS)'
                                              . $wrapflags),
                          libs => [ @$linklibs, mkwords('$(BIN_EX_LIBS)'),
                                    mkwords($utlibs) ],
                          deps => $linkdeps);
     }

     sub in2script {
         my %args = @_;
         my $script = $args{script};
         my @sources = @{$args{sources}};
         my $dofile = abs2rel(rel2abs(catfile($config{sourcedir},
                                              "util", "dofile.pl")),
                              rel2abs($config{builddir}));

         return "\nadd_custom_command(OUTPUT " . cmpath($script)
             . "\n  COMMAND " . cmql(mkwords('$(PERL)'),
                                     catfile($config{sourcedir}, "util",
                                             "file-from-stdout.pl"),
                                     '-x', $script, mkwords('$(PERL)'),
                                     '-I' . $config{builddir},
                                     '-Mconfigdata', $dofile,
                                     "-o$config{build_file}", @sources)
             . "\n  DEPENDS " . cmpathl(@sources, 'configdata.pm')
             . "\n  VERBATIM)"
             . "\nadd_custom_target(" . cmtarget($script) . " ALL DEPENDS "
             . cmpath($script) . ")"
             . "\nadd_dependencies(tests " . cmtarget($script) . ")\n";
     }

     # A shared library is a CMake SHARED library whose file is named
     # exactly as the Makefile names it, linked with the Makefile's
     # command line.  Libraries it depends on are linked the same way,
     # with -L and -l, and CMake is told about them only for ordering
     # and relinking.
     sub obj2shlib {
         my %args = @_;
         my $lib = $args{lib};
         my $name = cmtarget($lib) . "_shared";
         my $full = platform->sharedlib($lib);
         my $simple = platform->sharedlib_simple($lib);
         my ($linkdirs, $linklibs, $linkdeps) = link_inputs(@{$args{deps}});
         my @objs = grep { !platform->isdef($_) } @{$args{objs}};
         my @defs = map { platform->def($_) }
                    grep { platform->isdef($_) } @{$args{objs}};
         die "More than one exported symbol map" if scalar @defs > 1;

         my $shared_soname = defined $target{shared_sonameflag}
             ? ' ' . $target{shared_sonameflag} . basename($full) : '';
         my $shared_def = join('', map { ' ' . $target{shared_defflag} . $_ }
                                   @defs);
         my $out = "\nadd_library($name SHARED"
             . join('', map { "\n  \$<TARGET_OBJECTS:" . objtarget($_) . ">" }
                        @objs)
             . ")"
             . link_props(name => $name,
                          file => $full,
                          def => $defs[0],
                          ldflags => mkexpand('$(LIB_CFLAGS) '
                                              . join('', map { "$_ " }
                                                         @$linkdirs)
                                              . '$(LIB_LDFLAGS)'
                                              . $shared_soname . $shared_def),
                          libs => [ @$linklibs, mkwords('$(LIB_EX_LIBS)') ],
                          deps => $linkdeps);

         if (defined $simple && $simple ne $full) {
             $out .= "add_custom_command(OUTPUT " . cmpath($simple)
                 . "\n  COMMAND \${CMAKE_COMMAND} -E create_symlink "
                 . cmq(basename($full)) . " " . cmq($simple)
                 . "\n  DEPENDS $name VERBATIM)"
                 . "\nadd_custom_target(" . cmtarget($lib) . "_simple ALL"
                 . " DEPENDS " . cmpath($simple) . ")\n";
         }
         return $out;
     }

     "";
