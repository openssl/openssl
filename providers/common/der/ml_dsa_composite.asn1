-- Taken from https://datatracker.ietf.org/doc/draft-ietf-lamps-pq-composite-sigs/

pkixAlgs OBJECT IDENTIFIER ::= { 1 3 6 1 5 5 7 6 }

id-mldsa65-rsa3072-pkcs15-sha512 OBJECT IDENTIFIER ::= { pkixAlgs 42 } 
id-mldsa65-ecdsa-p256-sha512 OBJECT IDENTIFIER ::= { pkixAlgs 45 } 
