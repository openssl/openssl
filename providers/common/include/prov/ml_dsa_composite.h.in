#ifndef PROV_ML_DSA_COMPOSITE_H
#define PROV_ML_DSA_COMPOSITE_H

#include "internal/der.h"
#include "crypto/ml_dsa.h"
#include "prov/provider_ctx.h"

#define ML_DSA_COMPOSITE_PREFIX "436F6D706F73697465416C676F726974686D5369676E61747572657332303235"

/* Well known OIDs precompiled */
/* clang-format off */
{-
    $OUT = oids_to_c::process_leaves('providers/common/der/ml_dsa_composite.asn1',
                                     { dir => $config{sourcedir},
                                       filter => \&oids_to_c::filter_to_H });
-}
/* clang-format on */

typedef struct {
    ML_DSA_KEY *ml_dsa_key;
    EVP_PKEY *classic_key;
} ML_DSA_COMPOSITE_KEY;

typedef struct {
    OSSL_LIB_CTX *libctx;
    const char *alg;
    const unsigned char *oid;
    size_t oid_sz;
    uint8_t context_string[255]; /* ML_DSA_MAX_CONTEXT_STRING_LEN */
    size_t context_string_len;
    /*
     * Optional fixed entropy for the ML-DSA randomizer (test use only).
     * When test_entropy_len != 0 the 32-byte value is used instead of
     * RAND_priv_bytes_ex, enabling deterministic signing for test vectors.
     * Mirrors OSSL_SIGNATURE_PARAM_TEST_ENTROPY in ml_dsa_sig.c.
     */
    uint8_t test_entropy[ML_DSA_ENTROPY_LEN];
    size_t test_entropy_len;
    const char *prehash_alg;
    size_t prehash_len;

    /* CLASSIC */
    EVP_PKEY_CTX *classic_ctx;

    ML_DSA_COMPOSITE_KEY *key;

    /* sign vs verify, drives which ctx params (e.g. "signature") apply */
    int operation;
    /* 1 if the caller supplies PH(M) directly via OSSL_SIGNATURE_PARAM_ML_DSA_COMPOSITE_PREHASH */
    int have_prehash;
    /* streaming digest for PH(M); lazily created on the first msg_update() */
    EVP_MD_CTX *prehash_ctx;
    /* signature to check against, set via "signature" for verify_message_final() */
    unsigned char *sig;
    size_t siglen;
} PROV_ML_DSA_COMPOSITE_CTX;

ML_DSA_COMPOSITE_KEY *ossl_prov_ml_dsa_composite_new(PROV_CTX *ctx, const char *propq,
    int ml_dsa_evp_type);
void ossl_ml_dsa_composite_key_free(ML_DSA_COMPOSITE_KEY *key);

#endif /* PROV_ML_DSA_COMPOSITE_H */
