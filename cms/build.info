LIBS=../libcrypto

IF[{- !$disabled{cms} -}]
  $OPENSSLSRC=\
          cms_lib.c cms_asn1.c cms_att.c cms_io.c cms_smime.c cms_err.c \
          cms_sd.c cms_dd.c cms_cd.c cms_env.c cms_enc.c cms_ess.c \
          cms_pwri.c cms_kari.c cms_rsa.c cms_dh.c cms_ec.c cms_kem.c \
          cms_kemri.c

  # The CMS sources are compiled twice from the same source of truth: once
  # for libcrypto, which keeps exporting the CMS_* symbols through the 4.x
  # ABI, and once for libcms, where libcms_names.h renames every public
  # symbol to its libcms-native LIBCMS_* equivalent.
  SOURCE[../libcrypto]=$OPENSSLSRC

  SOURCE[../libcms]=$OPENSSLSRC
  DEFINE[../libcms]=OSSL_LIBCMS_NAMES
ENDIF

IF[{- !$disabled{ts} -}]
  $TSSRC=\
          ts_err.c ts_req_utils.c ts_req_print.c ts_rsp_utils.c \
          ts_rsp_print.c ts_rsp_sign.c ts_rsp_verify.c ts_verify_ctx.c \
          ts_lib.c ts_conf.c ts_asn1.c
  SOURCE[../libcrypto]=$TSSRC
  SOURCE[../libcms]=$TSSRC
ENDIF

$PKCS7SRC=\
        pk7_asn1.c pk7_lib.c pkcs7err.c pk7_doit.c pk7_smime.c pk7_attr.c \
        pk7_mime.c bio_pk7.c pk7_io.c
SOURCE[../libcrypto]=$PKCS7SRC
IF[{- !$disabled{cms} -}]
  SOURCE[../libcms]=$PKCS7SRC
ENDIF
